{
  "listen_addr": ":8080",
  "ca_cert_path": "",
  "ca_key_path": "",
  "ca_cert_output_path": "ca-cert.pem",
  "ca_key_output_path": "ca-key.pem",
  "enable_mitm": true,
  "excluded_domains": [],
  "verbose_logging": true,
  "log_requests": true,
  "max_idle_conns": 200,
  "idle_conn_timeout_seconds": 90,
  "tls_handshake_timeout_seconds": 10,
  "min_tls_version": "1.2",
  "tls_next_protos": [
    "h2",
    "http/1.1"
  ],
  "proxy_name": "MITM-Proxy",
  "admin_enabled": true,
  "admin_addr": "127.0.0.1:9090",
  "admin_token": "",
  "admin_read_token": "",
  "admin_ui": true,
  "admin_store": "dashboard.db",
  "cache": {
    "enabled": true,
    "directory": "cache",
    "include_domains": [],
    "exclude_domains": [],
    "include_extensions": [
      "jpg",
      "png",
      "webp",
      "css",
      "js"
    ],
    "exclude_extensions": [],
    "ttl": 3600
  },
  "blocked_ports": [
    25,
    445,
    3389
  ],
  "blocked_domains": [],
  "blocked_ips": [],
  "block_action": "deny",
  "block_response_status": 403,
  "traffic_capture": {
    "store_bodies": true,
    "max_body_bytes": 32768,
    "redact_bodies": true,
    "store_headers": true,
    "redacted_headers": [
      "Authorization",
      "Proxy-Authorization"
    ],
    "store_cookies": true,
    "redacted_cookies": []
  },
  "proxy_auth": {
    "enabled": true,
    "realm": "MITM Proxy",
    "require_auth_for_loopback": true,
    "default_action": "allow"
  }
}